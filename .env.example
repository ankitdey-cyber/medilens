# Copy this file to `.env.local` (higher precedence) or `.env` for local development.
# Both files are loaded automatically by server.ts (.env.local first, then .env).

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides (defaults shown below).
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this applet is hosted (optional locally).
APP_URL="http://localhost:3000"
